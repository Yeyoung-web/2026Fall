# Development: leave empty to use Vite /api proxy.
VITE_API_URL=
# Docker defaults to shared mode; GitHub Pages defaults to local demo.
VITE_SHARED_DEFAULT=0
# Production: replace with the real same-origin HTTPS address and set COOKIE_SECURE=true.
APP_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
COOKIE_SECURE=false
API_PORT=3001
DB_PATH=/tmp/receiptory-server/receiptory.sqlite
